<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DC Concerts</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-gray-100 font-sans antialiased">
<main class="max-w-3xl mx-auto p-4 sm:p-8">
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">DC Concerts</h1>
    <p class="text-gray-400 mt-2">
      Upcoming shows at DC-area venues featuring artists in your Spotify library.
    </p>
    <p class="text-sm text-gray-500 mt-2">
      <span id="visible-count">{{ matched_count }}</span> of {{ matched_count }} matches shown
      (from {{ total_events }} events scanned) &middot; updated {{ generated_at }}
      &middot; <a href="concerts.ics" class="text-indigo-400 hover:underline">subscribe to calendar feed</a>
    </p>
  </header>

  <section class="mb-8">
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-xs uppercase tracking-wider text-gray-500">Venues</h2>
      <div class="flex gap-3 text-xs">
        <button type="button" id="select-all" class="text-indigo-400 hover:underline">All</button>
        <button type="button" id="select-none" class="text-indigo-400 hover:underline">None</button>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      {% for v in venues %}
      <label class="inline-flex items-center text-xs px-3 py-1 rounded-full bg-gray-800 text-gray-400 has-[:checked]:bg-indigo-700 has-[:checked]:text-white cursor-pointer select-none transition">
        <input type="checkbox" class="venue-filter sr-only" value="{{ v }}" checked>
        <span>{{ v }}</span>
      </label>
      {% endfor %}
    </div>
  </section>

  {% for month, month_events in events_by_month %}
  <section class="mb-8 month-section">
    <h2 class="text-xl font-semibold text-gray-300 mb-4 border-b border-gray-800 pb-2">
      {{ month }}
    </h2>
    <ul class="space-y-3">
    {% for ev in month_events %}
      <li data-venue="{{ ev.venue }}" class="bg-gray-900 rounded-lg p-4">
        <div class="flex gap-4 items-start">
          <div class="text-center min-w-[56px] pt-1">
            <div class="text-xs uppercase text-gray-500">{{ ev.date_label.dow }}</div>
            <div class="text-2xl font-bold leading-none mt-1">{{ ev.date_label.day }}</div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-lg leading-tight">{{ ev.headliner }}</div>
            <div class="text-sm text-gray-400 mt-0.5">{{ ev.venue }}</div>
            {% if ev.supports %}
            <div class="text-xs text-gray-500 mt-1 truncate">with {{ ev.supports | join(', ') }}</div>
            {% endif %}
            <div class="mt-2 flex flex-wrap gap-1">
            {% for m in ev.matches %}
              <span class="text-xs px-2 py-0.5 rounded-full {% if m.role == 'headliner' %}bg-green-900/60 text-green-200{% else %}bg-blue-900/60 text-blue-200{% endif %}">
                {{ m.name }}{% if m.role == 'support' %} · opener{% endif %}
              </span>
            {% endfor %}
            </div>
            {% if ev.on_sale_label %}
            <div class="text-xs text-amber-400/90 mt-2">🎟 {{ ev.on_sale_label }}</div>
            {% endif %}
            <div class="mt-2 flex flex-wrap items-center gap-3">
            {% if ev.url %}
              <a href="{{ ev.url }}" target="_blank" rel="noopener" class="text-sm text-indigo-400 hover:underline">Tickets →</a>
            {% endif %}
              <a href="{{ ev.email_url }}" class="text-sm text-pink-400 hover:underline">✉ Email Jules</a>
            </div>
          </div>
        </div>
      </li>
    {% endfor %}
    </ul>
  </section>
  {% endfor %}

  <p id="empty-state" class="text-center text-gray-500 py-8 hidden">
    No venues selected. Tick one above to see events.
  </p>

  <footer class="text-xs text-gray-600 mt-12 pt-4 border-t border-gray-900">
    Sources: Ticketmaster Discovery API, Black Cat scrape. Matching is exact-name against Spotify liked tracks after normalization.
  </footer>
</main>

<script>
(() => {
  const STORAGE_KEY = "concerts-venue-filter-v1";
  const checkboxes = document.querySelectorAll("input.venue-filter");
  const events = document.querySelectorAll("li[data-venue]");
  const months = document.querySelectorAll(".month-section");
  const countEl = document.getElementById("visible-count");
  const emptyEl = document.getElementById("empty-state");

  const stored = (() => {
    try { return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || "null")); }
    catch { return null; }
  })();
  if (stored) {
    checkboxes.forEach(c => { c.checked = stored.has(c.value); });
  }

  function apply() {
    const selected = new Set(
      Array.from(checkboxes).filter(c => c.checked).map(c => c.value)
    );
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...selected]));

    let visible = 0;
    events.forEach(li => {
      const show = selected.has(li.dataset.venue);
      li.hidden = !show;
      if (show) visible++;
    });
    months.forEach(sec => {
      sec.hidden = !sec.querySelector("li:not([hidden])");
    });
    countEl.textContent = visible;
    emptyEl.classList.toggle("hidden", visible > 0 || selected.size > 0);
  }

  checkboxes.forEach(c => c.addEventListener("change", apply));
  document.getElementById("select-all").addEventListener("click", () => {
    checkboxes.forEach(c => c.checked = true); apply();
  });
  document.getElementById("select-none").addEventListener("click", () => {
    checkboxes.forEach(c => c.checked = false); apply();
  });
  apply();
})();
</script>
</body>
</html>
